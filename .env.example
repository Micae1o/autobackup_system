## Shared
BACKUP_AGENT_ID=local-agent
BACKUP_HMAC_SECRET=change-me-please

## backup-server
BACKUP_SERVER_PORT=3002
BACKUP_STORAGE_DIR=./data/backups
BACKUP_EXPORTS_DIR=./data/exports
BACKUP_SERVER_PRIVATE_KEY_PATH=./keys/backup-server-private.pem

## backup-agent
BACKUP_AGENT_PORT=3001
BACKUP_AGENT_HOST=127.0.0.1
BACKUP_AGENT_API_TOKEN=change-me-agent-token
BACKUP_SERVER_URL=http://localhost:3002
BACKUP_SERVER_PUBLIC_KEY_PATH=./keys/backup-server-public.pem

## PostgreSQL env (used by pg_dump/pg_restore)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

